PORT=4000
# For Aiven, set either DATABASE_URL or the DB_* fields below.
DATABASE_URL=
DB_HOST=
DB_PORT=3306
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=
DB_SSL=true
# Paste the Aiven CA certificate PEM here, or use DB_SSL_CA_FILE=/path/to/ca.pem
DB_SSL_CA=
DB_SSL_CA_FILE=
CORS_ORIGIN=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=12345
# Optional Render persistent disk mount path for uploaded sound effects
UPLOAD_DIR=
